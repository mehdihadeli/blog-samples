<!-- Embedded ClickHouse Keeper — lets ReplicatedMergeTree tables (used by
     Langfuse migrations with ON CLUSTER default) work on a single node
     without an external ZooKeeper/Keeper cluster. -->
<clickhouse>
    <!-- Single-node macros: ReplicatedMergeTree paths use {shard}/{replica} -->
    <macros>
        <shard>01</shard>
        <replica>01</replica>
    </macros>
    <keeper_server>
        <tcp_port>9181</tcp_port>
        <server_id>1</server_id>
        <log_storage_path>/var/lib/clickhouse/coordination/log</log_storage_path>
        <snapshot_storage_path>/var/lib/clickhouse/coordination/snapshots</snapshot_storage_path>
        <coordination_settings>
            <operation_timeout_ms>10000</operation_timeout_ms>
            <session_timeout_ms>30000</session_timeout_ms>
            <raft_logs_level>information</raft_logs_level>
        </coordination_settings>
        <raft_configuration>
            <server>
                <id>1</id>
                <hostname>clickhouse-langfuse</hostname>
                <port>9234</port>
            </server>
        </raft_configuration>
    </keeper_server>
</clickhouse>
