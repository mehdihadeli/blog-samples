<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- tests/Directory.Build.props adds a global Xunit using for test projects;
         this is a plain web host, so strip it. -->
    <Using Remove="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\BuildingBlocks\BuildingBlocks.Integration.Wolverine\BuildingBlocks.Integration.Wolverine.csproj" />
    <ProjectReference Include="..\..\..\src\BuildingBlocks\BuildingBlocks.Integration.Wolverine.RabbitMQ\BuildingBlocks.Integration.Wolverine.RabbitMQ.csproj" />
    <ProjectReference Include="..\..\..\src\BuildingBlocks\BuildingBlocks.Integration.Wolverine.Kafka\BuildingBlocks.Integration.Wolverine.Kafka.csproj" />
  </ItemGroup>

</Project>
