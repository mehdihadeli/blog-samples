# Core GPU selection
ENGINE_VISIBLE_DEVICES=0

# Router mode
ROUTING_LOGIC=roundrobin
ROUTER_EXTRA_ARGS=

# Engine flags
VLLM_SERVER_DEV_MODE=0
VLLM_EXTRA_ARGS=

# Shared KV cache
COMPOSE_PROFILES=
LMCACHE_REMOTE_URL=
LMCACHE_REMOTE_SERDE=naive

# Grafana credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Examples
# Session routing:
# ROUTING_LOGIC=session
# ROUTER_EXTRA_ARGS=--session-key x-session-id
#
# Sleep mode:
# VLLM_SERVER_DEV_MODE=1
# VLLM_EXTRA_ARGS=--enable-sleep-mode
#
# Shared cache:
# COMPOSE_PROFILES=shared-kv
# LMCACHE_REMOTE_URL=cache-server:8000
