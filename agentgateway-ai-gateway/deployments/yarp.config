{
  "$schema": "https://raw.githubusercontent.com/dotnet/yarp/main/src/Application/Config/yarp-config-schema.json",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "llm-api-key": {
        "ClusterId": "agentgateway-llm",
        "Match": { "Path": "/v1/{**catch-all}" }
      },
      "mcp": {
        "ClusterId": "agentgateway-mcp",
        "Match": { "Path": "/mcp/{**catch-all}" }
      },
      "a2a": {
        "ClusterId": "agentgateway-a2a",
        "Match": { "Path": "/a2a/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/a2a" }]
      },
      "llm-pkce": {
        "ClusterId": "agentgateway-browser",
        "Match": { "Path": "/browser/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/browser" }]
      },
      "vscode": {
        "ClusterId": "agentgateway-vscode",
        "Match": { "Path": "/vscode/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/vscode" }]
      },
      "oauth-callback": {
        "ClusterId": "agentgateway-browser",
        "Match": { "Path": "/oauth/callback" }
      },
      "admin": {
        "ClusterId": "agentgateway-admin",
        "Match": { "Path": "/admin/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/admin" }]
      },
      "metrics": {
        "ClusterId": "agentgateway-metrics",
        "Match": { "Path": "/metrics" }
      },
      "otel-metrics": {
        "ClusterId": "otel-collector-metrics",
        "Match": { "Path": "/otel-metrics/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/otel-metrics" }]
      },
      "grafana": {
        "ClusterId": "grafana",
          "Match": { "Path": "/grafana/{**catch-all}" },
          "Transforms": [{ "RequestHeaderOriginalHost": "true" }]
      },
      "auth": {
        "ClusterId": "keycloak",
        "Match": { "Path": "/auth/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/auth" }]
      },
      "langfuse": {
        "ClusterId": "langfuse",
        "Match": {
          "Hosts": ["langfuse.localhost"],
          "Path": "/{**catch-all}"
        },
        "Transforms": [{ "RequestHeaderOriginalHost": "true" }]
      }
    },
    "Clusters": {
      "agentgateway-llm": {
        "Destinations": { "default": { "Address": "http://agentgateway:4000/" } }
      },
      "agentgateway-mcp": {
        "Destinations": { "default": { "Address": "http://agentgateway:3000/" } }
      },
      "agentgateway-a2a": {
        "Destinations": { "default": { "Address": "http://agentgateway:3001/" } }
      },
      "agentgateway-browser": {
        "Destinations": { "default": { "Address": "http://agentgateway:4001/" } }
      },
      "agentgateway-vscode": {
        "Destinations": { "default": { "Address": "http://agentgateway:4002/" } }
      },
      "agentgateway-admin": {
        "Destinations": { "default": { "Address": "http://agentgateway:15000/" } }
      },
      "agentgateway-metrics": {
        "Destinations": { "default": { "Address": "http://agentgateway:15020/" } }
      },
      "otel-collector-metrics": {
        "Destinations": { "default": { "Address": "http://otel-collector:8889/" } }
      },
      "grafana": {
        "Destinations": { "default": { "Address": "http://grafana:3000/" } }
      },
      "keycloak": {
        "Destinations": { "default": { "Address": "http://keycloak:8080/" } }
      },
      "langfuse": {
        "Destinations": { "default": { "Address": "http://langfuse-web:3000/" } }
      }
    }
  }
}
