  "panels": [
    {
      "id": 1,
      "title": "LLM requests by user",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (user_id) (rate(agentgateway_gen_ai_client_requests_total[$__rate_interval]))",
          "legendFormat": "{{user_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Token usage by user",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 40, "lineWidth": 1 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (user_id) (increase(agentgateway_gen_ai_client_token_usage_sum[$__range]))",
          "legendFormat": "{{user_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "LLM requests by model",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (gen_ai_request_model) (rate(agentgateway_gen_ai_client_requests_total[$__rate_interval]))",
          "legendFormat": "{{gen_ai_request_model}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "LLM errors",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "thresholds" } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(agentgateway_gen_ai_client_errors_total[$__range]))",
