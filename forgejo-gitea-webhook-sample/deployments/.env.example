# Image tags used by this local lab.
# Instance 1 is Forgejo (source control). If codeberg.org is unreachable,
# swap the host for the official mirror: data.forgejo.org/forgejo/forgejo:17
FORGEJO_IMAGE=codeberg.org/forgejo/forgejo:17
GITEA_IMAGE=docker.gitea.com/gitea:28.3.0
GITEA_RUNNER_IMAGE=docker.gitea.com/gitea/runner:latest
DOTNET_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0-alpine

# Host ports, bound to 127.0.0.1 only.
FORGEJO_HTTP_PORT=3010
GITEA_APP_HTTP_PORT=3110

# Registration token for the act runner, obtained from the application Gitea
# instance. Leave empty here; copy this file to .env and fill it in before
# starting the runner (see the README).
GITEA_RUNNER_REGISTRATION_TOKEN=

# Cross-instance webhook bridge. The Forgejo instance delivers its push
# webhook to this service, which calls workflow_dispatch on the Gitea CI
# instance. GITEA_CI_TOKEN must be an access token from the CI instance with
# the `write:repository` scope.
BRIDGE_HTTP_PORT=3210
BRIDGE_TARGET_REPO=admin/dotnet-ci
BRIDGE_TARGET_WORKFLOW=ci.yml
BRIDGE_TARGET_REF=main
BRIDGE_SOURCE_BRANCH=main
GITEA_CI_TOKEN=
